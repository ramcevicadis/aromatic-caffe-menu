rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Menu items - Everyone can read, only authenticated users can write
    match /items/{itemId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    
    // Categories - Everyone can read, only authenticated users can write
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    
    // Settings (WiFi, Info, etc.) - Everyone can read, only authenticated users can write
    match /settings/{settingId} {
      allow read: if true;
      allow update: if request.auth != null;
    }
    
    // Admin users list - Only authenticated users can read and write
    match /admins/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}
